# =============================================================================
# GRAFANA TEMPO (TRACE STORAGE) - Single Binary Mode
# =============================================================================

image:
  repository: docker.io/grafana/tempo

# ------------------------
# CORE APP CONFIGURATION
# ------------------------
tempo:
  repositoryConfigs:
    search:
      backend: local
      local:
        path: /var/tempo/search

  config: |
    multitenancy_enabled: false

    server:
      http_listen_port: 3200

    distributor:
      receivers:
        otlp:
          protocols:
            grpc:
              endpoint: 0.0.0.0:4317
            http:
              endpoint: 0.0.0.0:4318

    ingester:
      max_block_duration: 5m
      lifecycler:
        ring:
          kvstore:
            store: inmemory

    compactor:
      compaction:
        block_retention: 48h

    storage:
      trace:
        backend: local
        block:
          version: vParquet4
        local:
          path: /var/tempo/traces
        wal:
          path: /var/tempo/wal

    overrides:
      defaults:
        metrics_generator:
          processors:
            - service-graphs
            - local-blocks

    metrics_generator:
      storage:
        path: /var/tempo/generator/wal
        remote_write:
          - url: "http://prometheus-operated.monitoring.svc:9090/api/v1/write"
  
      traces_storage:
        path: /var/tempo/generator/traces 
    
      processor:
        local_blocks:
          flush_to_storage: true
        service_graphs:
          dimensions:
            - deployment.environment
            - k8s.namespace.name

# ------------------------
# HEALTH CHECKS (Probes)
# ------------------------
# Startup probe gives Tempo time to replay the WAL without being killed
startupProbe:
  httpGet:
    path: /ready
    port: 3200
  failureThreshold: 30
  periodSeconds: 10

livenessProbe:
  httpGet:
    path: /ready
    port: 3200
  initialDelaySeconds: 60
  periodSeconds: 10
  failureThreshold: 10

readinessProbe:
  httpGet:
    path: /ready
    port: 3200
  initialDelaySeconds: 30
  periodSeconds: 10

# ------------------------
# SECURITY CONTEXT
# ------------------------
podSecurityContext:
  fsGroup: 10001

# ------------------------
# PERSISTENCE
# ------------------------
persistence:
  enabled: true
  storageClass: {{ .Values.global.storageClass }}
  size: {{ .Values.tempo.storageSize | default "1Gi" }}

# ------------------------
# RESOURCE LIMITS
# ------------------------
resources:
  requests:
    cpu: {{ .Values.global.cpuRequest }}
    memory: {{ .Values.global.memoryRequest }}
  limits:
    cpu: {{ .Values.global.cpuLimit }}
    memory: {{ .Values.global.memoryLimit }}

# ------------------------
# MONITORING
# ------------------------
serviceMonitor:
  enabled: true
  interval: 30s
  additionalLabels:
    release: kube-prometheus-stack








