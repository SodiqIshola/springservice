# =============================================================================
# GRAFANA
# =============================================================================
grafana:
  enabled: true

  # Disable built-in dashboards
  defaultDashboardsEnabled: false
  defaultDashboardsTimezone: utc
  defaultDashboardsEditable: true
  defaultDashboardsInterval: 1m

  # ---------------------------------------------------------------------------
  # SECURITY
  # ---------------------------------------------------------------------------
  podSecurityContext:
    fsGroup: 472
  securityContext:
    runAsNonRoot: true
    runAsUser: 472

  # ---------------------------------------------------------------------------
  # HEALTH CHECKS
  # ---------------------------------------------------------------------------
  startupProbe:
    httpGet:
      path: /api/health
      port: 3000
    failureThreshold: 30
    periodSeconds: 10
  livenessProbe:
    httpGet:
      path: /api/health
      port: 3000
    initialDelaySeconds: 60
    periodSeconds: 10
    failureThreshold: 3
  readinessProbe:
    httpGet:
      path: /api/health
      port: 3000
    initialDelaySeconds: 60
    periodSeconds: 10
    failureThreshold: 10

  # ---------------------------------------------------------------------------
  # GRAFANA METRICS
  # ---------------------------------------------------------------------------
  serviceMonitor:
    enabled: true
    interval: 30s
    path: /metrics
    labels:
      release: kube-prometheus-stack

  # ---------------------------------------------------------------------------
  # ADMIN LOGIN
  # ---------------------------------------------------------------------------
  adminUser: {{ .Values.grafana.adminUser }}
  adminPassword: {{ .Values.grafana.adminPassword }}

  # ---------------------------------------------------------------------------
  # RESOURCES
  # ---------------------------------------------------------------------------
  resources:
    requests:
      cpu: {{ .Values.global.cpuRequest }}
      memory: {{ .Values.global.memoryRequest }}
    limits:
      cpu: {{ .Values.global.cpuLimit }}
      memory: {{ .Values.global.memoryLimit }}

  # ---------------------------------------------------------------------------
  # PLUGINS
  # ---------------------------------------------------------------------------
  plugins:
    - grafana-clock-panel
    - grafana-piechart-panel
    - grafana-polystat-panel

  # ---------------------------------------------------------------------------
  # INGRESS
  # ---------------------------------------------------------------------------
  ingress:
    enabled: true
    ingressClassName: traefik
    annotations:
      kubernetes.io/ingress.class: traefik
      traefik.ingress.kubernetes.io/router.entrypoints: web
    hosts:
      - {{ .Values.grafana.host }}
    path: /
    pathType: Prefix

  # ---------------------------------------------------------------------------
  # STORAGE
  # ---------------------------------------------------------------------------
  persistence:
    enabled: true
    storageClassName: {{ .Values.global.storageClass }}
    accessModes:
      - ReadWriteOnce
    size: {{ .Values.grafana.storageSize | default "1Gi" }}
    type: pvc

  # ---------------------------------------------------------------------------
  # SIDECAR PROVISIONING
  # ---------------------------------------------------------------------------
  sidecar:
    dashboards:
      enabled: true
      label: grafana_dashboard
      labelValue: "1"
      searchNamespace: ALL
      folderAnnotation: grafana_folder
      provider:
        foldersFromFilesStructure: true

    datasources:
      enabled: true
      label: grafana_datasource
      labelValue: "1"
      searchNamespace: ALL
      defaultDatasourceEnabled: false

    alerts:
      enabled: true
      label: grafana_alert
      labelValue: "1"
      searchNamespace: ALL

  # ---------------------------------------------------------------------------
  # GRAFANA SETTINGS
  # ---------------------------------------------------------------------------
  grafana.ini:
    server:
      root_url: http://{{ .Values.grafana.host }}
      serve_from_sub_path: false

    dashboards:
      versions_to_keep: 20

    images:
      cleanup_enabled: true
      days_to_keep: {{ .Values.grafana.retention | default "7d" }}

