# =============================================================================
# Config: Prometheus Stack Configuration
# Description: Prometheus + Grafana monitoring stack
# ============================================================================

# =============================================================================
# GLOBAL SETTINGS
# =============================================================================
global:
  externalLabels:
    environment: {{ .Values.global.environment }}

  # Shared RBAC permissions for monitoring components
  rbac:
    create: true

    extraRoleRules:
      - apiGroups: [""]
        resources:
          - nodes
          - nodes/metrics
          - nodes/stats
          - nodes/proxy
          - services
          - endpoints
          - pods
        verbs:
          - get
          - list
          - watch


# =============================================================================
# PROMETHEUS
# =============================================================================
prometheus:
  enabled: true

  # ---------------------------------------------------------------------------
  # INGRESS
  # ---------------------------------------------------------------------------
  ingress:
    enabled: true
    ingressClassName: traefik
    annotations:
      kubernetes.io/ingress.class: traefik
      traefik.ingress.kubernetes.io/router.entrypoints: web
    hosts:
      - {{ .Values.prometheus.host }}
    paths:
      - /
    pathType: Prefix

  # ---------------------------------------------------------------------------
  # SELF MONITORING
  # ---------------------------------------------------------------------------
  serviceMonitor:
    enabled: true
    interval: 30s
    selfMonitor: true

  # ---------------------------------------------------------------------------
  # PROMETHEUS ENGINE
  # ---------------------------------------------------------------------------
  prometheusSpec:

    portName: web

    # Allows Prometheus to receive pushed metrics
    enableRemoteWriteReceiver: true

    # Discover ServiceMonitors across namespaces
    serviceMonitorSelectorNilUsesHelmValues: false

    scrapeInterval: 30s
    evaluationInterval: 30s

    retention: {{ .Values.prometheus.retention | default "7d" }}
    retentionSize: 500MB
    walCompression: true

    storageSpec:
      volumeClaimTemplate:
        spec:
          storageClassName: {{ .Values.global.storageClass }}
          accessModes:
            - ReadWriteOnce
          resources:
            requests:
              storage: {{ .Values.prometheus.storageSize | default "1Gi" }}

    # -------------------------------------------------------------------------
    # RESOURCES
    # -------------------------------------------------------------------------
    resources:
      requests:
        cpu: {{ .Values.global.cpuRequest }}
        memory: {{ .Values.global.memoryRequest }}
      limits:
        cpu: {{ .Values.global.cpuLimit }}
        memory: {{ .Values.global.memoryLimit }}

    # -------------------------------------------------------------------------
    # HEALTH CHECKS
    # -------------------------------------------------------------------------
    containers:
      - name: prometheus
        startupProbe:
          httpGet:
            path: /-/ready
            port: web
          failureThreshold: 30
          periodSeconds: 10
        readinessProbe:
          httpGet:
            path: /-/ready
            port: web
          periodSeconds: 5
        livenessProbe:
          httpGet:
            path: /-/healthy
            port: web
          periodSeconds: 15

#    # -------------------------------------------------------------------------
